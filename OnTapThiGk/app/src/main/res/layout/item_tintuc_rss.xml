<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAnhDaiDien"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@color/image_placeholder_bg"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            tools:srcCompat="@drawable/anh1" />

        <LinearLayout
            android:background="@color/news_header_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTieuDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tiêu đề bài báo"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="VnExpress - Giáo dục hôm nay có gì mới?" />

            <TextView
                android:id="@+id/tvMoTaTin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Mô tả ngắn của bài báo hiển thị tại đây."
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="Mô tả ngắn gọn về nội dung bài báo để người dùng dễ theo dõi hơn." />

            <TextView
                android:id="@+id/tvNgayDang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ngày đăng"
                android:textColor="@color/news_date_text"
                android:textSize="10sp"
                tools:text="Mon, 20 Apr 2026 09:30:00 +0700" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
